{
    "name": "three-cards-service",
    "version": "1.0.0",
    "description": "",
    "main": "./src/app.js",
    "scripts": {
        "test": "jest",
        "test-coverage": "jest --collect-coverage",
        "dev": "nodemon --es-module-specifier-resolution=node --watch ./src ./src/app.js",
        "debug": "nodemon --es-module-specifier-resolution=node --watch ./ --inspect ./src/app.js",
        "prod": "node --max-old-space-size=8192 --es-module-specifier-resolution=node ./src/app.js",
        "reg": "npm set registry http://npm.lumigame.com",
        "stats": "nodemon --es-module-specifier-resolution=node --watch ./tests ./tests/results.js"
    },
    "author": "",
    "license": "ISC",
    "type": "module",
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "dependencies": {
        "d3-array": "^3.2.0",
        "lodash": "^4.17.19",
        "nodemon": "^2.0.4",
        "random": "^3.0.6",
        "random-js": "^2.1.0",
        "sc-game-base": "4.1.0"
    },
    "resolutions": {
        "sc-base-apis": "1.18.2",
        "sc-base-database": "1.11.1",
        "socket.io-parser": "4.0.5",
        "mongoose": "5.13.20"
    },
    "devDependencies": {
        "@babel/core": "7.28.5",
        "@babel/preset-env": "7.28.5",
        "@commitlint/cli": "9.1.2",
        "@commitlint/config-conventional": "9.1.2",
        "@types/jest": "26.0.24",
        "babel-jest": "27.5.1",
        "husky": "4.3.8",
        "install": "0.13.0",
        "jest": "27.5.1",
        "jest-extended": "0.11.5",
        "jest-micro-auto-stub": "1.0.9",
        "jest-sonar-reporter": "2.0.0"
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    }
}
